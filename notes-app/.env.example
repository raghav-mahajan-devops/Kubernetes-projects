# Copy to .env and adjust. All are optional; defaults are for local dev.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
LOG_LEVEL=INFO

# Leave POSTGRES_DB unset to use SQLite.
# SQLITE_PATH=/app/data/db.sqlite3

# Set these to switch to PostgreSQL (e.g. a "db" service in docker-compose)
# POSTGRES_DB=notes
# POSTGRES_USER=notes
# POSTGRES_PASSWORD=notes
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
